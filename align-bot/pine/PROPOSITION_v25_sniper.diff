+snZone = not na(zBas) and close >= zBas - 0.5 * atrC and close <= zHaut + 0.5 * atrC
+snOk = snCtx and snZone and not na(snLvl) and (dirPlan == -1 ? snLvl >= close : snLvl <= close) and (na(snUp) or (dirPlan == -1 ? snLvl < snUp : snLvl > snUp)) and snRej
+if snOk
